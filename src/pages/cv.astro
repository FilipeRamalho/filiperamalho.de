---
import {Image} from "astro:assets";

import Main from '@/layouts/Main.astro'

import me from "@/assets/img/me.webp";
import bg from "@/assets/logos/bg.svg";
import prtg from "@/assets/logos/prtg.svg";
import ey from "@/assets/logos/ey.svg";
import grafana from "@/assets/logos/grafana.svg";
import jgu from "@/assets/logos/jgu.svg";
import python from "@/assets/logos/python.svg";
import pwsh from "@/assets/logos/pwsh.svg";
import tux from "@/assets/logos/tux.svg";
import typescript from "@/assets/logos/typescript.svg";
import pqsql from "@/assets/logos/pqsl.svg";
import windowsserver from "@/assets/logos/windowsserver.svg";
import typst from "@/assets/logos/typst.svg";
import torchquad from "@/assets/logos/torchquad.svg";
import pytorch from "@/assets/logos/pytorch.svg";
import mathematica from "@/assets/logos/mathematica.svg";

import Picture22 from "@/assets/img/22.jpeg";
import Picture23 from "@/assets/img/23.jpeg";
import Picture24 from "@/assets/img/24.jpeg";
import ImageDetails from "@/components/ImageDetails.astro";
import Icon from "@/components/Icon.astro";
---

<Main>
    <!--  Used padding here because of the scroll position at #work -->
    <section aria-label="work" class="pt-10 my-10">
        <h2 class="text-2xl sm:text-3xl font-bold mb-3 basis-full">
            Erfahrung
        </h2>

        <article>
            <i>11/2023-03/2026</i>

            <h3 class="mb-2 space-x-2">
                <b>Monitoring Werkstudent</b>

                <Icon href="https://www.bghm.de/bghm" alt="BG Logo" src={bg}>
                    Berufsgenossenschaft Holz und Metall
                </Icon>
            </h3>

            <ul>
                <li>
                    Einführung von Grafana in die interne Monitoring-Landschaft.
                </li>
                <li>
                    Anbindung von PRTG-Daten via REST und SQL.
                </li>
                <li>
                    Migration von 2.000+ Servern von MS SCOM zu PRTG.
                </li>
                <li>
                    Entwicklung von PowerShell-Sensoren/-Skripte für PRTG.
                </li>
                <li>
                    Schulung von Auszubildenden in Monitoring-Tools und Skriptentwicklung (PowerShell)
                </li>
            </ul>

            <p class="mt-1 mb-10 leading-8 inline-block align-top">
                <b>Relevante Skills:</b>

                <Icon href="https://www.paessler.com/de/prtg" alt="PRTG Logo" src={prtg} style="mr-2" >
                    PRTG
                </Icon>

                <Icon href="https://grafana.com/oss/grafana" alt="Grafana Logo" style="mr-2" src={grafana}>
                    Grafana
                </Icon>

                <Icon href="https://www.postgresql.org" alt="PostgreSQL Logo" style="mr-2" src={pqsql}>
                    PostgreSQL
                </Icon>

                <Icon href="https://github.com/PowerShell/PowerShell" alt="Powershell Logo" style="mr-2" src={pwsh}>
                    PowerShell
                </Icon>

                <Icon href="https://www.microsoft.com/de-de/windows-server" alt="Windows Server" style="mr-2" src={windowsserver}>
                    Windows Server
                </Icon>
            </p>
        </article>

        <article>
            <i>09/2021 - 10/2023</i>

            <h3 class="mb-2 space-x-2">
                <b>HPC Hilfswissenschaftler</b>

                <Icon href="https://www.zdv.uni-mainz.de" alt="JGU Logo" src={jgu}>
                    Johannes Gutenberg-Universität Mainz (ZDV Mainz)
                </Icon>
            </h3>

            <ul>
                <li>
                    Alltägliche Hardwarewartungsarbeiten.
                </li>

                <li>
                    Webseiten auf moderne Typescript-Frameworks portiert.
                </li>

                <li>
                    Python-Skripte für den HPC-Betrieb entwickelt.
                </li>

                <li>
                    Entwicklung und Koordination eines Asset-Management-Systems.
                </li>
            </ul>

            <p class="mt-1 mb-10 leading-8 inline-block align-top">
                <b>Relevante Skills:</b>

                <Icon href="https://python.org" alt="Python Logo" style="mr-2" src={python}>
                    Python
                </Icon>

                <Icon href="https://www.typescriptlang.org" alt="Typescript Logo" style="mr-2" src={typescript}>
                    Typescript/Javascript
                </Icon>

                <Icon href="https://www.kernel.org" alt="Tux" style="mr-2" src={tux}>
                    Linux
                </Icon>
            </p>
        </article>
    </section>

    <section id="education" aria-label="education" class="pt-10 my-10">
        <h2 class="text-2xl sm:text-3xl font-bold mb-3 basis-full">
            Bildung
        </h2>

        <article>
            <i>Abschluss März 2026</i>

            <h3 class="mb-2 space-x-2">
                <b>Bsc. Physics</b>

                <Icon href="https://www.uni-mainz.de" alt="JGU Logo" src={jgu}>
                   Johannes-Gutenberg-Universität Mainz
                </Icon>
            </h3>

            <ul>
                <li>
                    Nebenfach: Informatik
                </li>

                <li>
                    Bachelorarbeit:
                    "Neural network implementation of a variational method to determine solutions of the Schrödinger
                    equation"
                    (Univ.-Prof. Dr. Marc Vanderhaeghen)
                    <ul>
                        <li>
                            Entwicklung eines Deep-Learning-Modells zur Lösung der Schrödingergleichung.
                        </li>
                        <li>
                            Verwendung von PyTorch für Modellentwicklung und Torchquad für numerische Integration.
                        </li>
                    </ul>
                </li>
            </ul>

            <p class="mt-1 mb-10 leading-8 inline-block align-top">
                <b>Relevante Skills:</b>

                <Icon href="https://python.org" alt="Python Logo" style="mr-2" src={python}>
                    Python
                </Icon>

                <Icon href="https://typst.app" alt="Typst Logo" style="mr-2" src={typst}>
                    Typst
                </Icon>

                <Icon href="https://www.wolfram.com/mathematica/" alt="Mathematica Logo" style="mr-2" src={mathematica}>
                    Mathematica
                </Icon>

                <Icon href="https://pytorch.org" alt="PyTorch Logo" style="mr-2" src={pytorch}>
                    PyTorch
                </Icon>

                <Icon href="https://torchquad.readthedocs.io/en/main/" alt="Torchquad Logo" style="mr-2" src={torchquad}>
                    Torchquad
                </Icon>
            </p>
        </article>
    </section>
</Main>